{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "jsx": "react-jsx",

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "paths": { "@/*": ["./src/*"] },

    "resolveJsonModule": true,
    "types": ["vite/client", "react", "react-dom"],

    "noEmit": true
  },
  "include": ["src"]
}
